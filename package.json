
{
  "name": "student-routine-management-system",
  "version": "1.0.0",
  "description": "Student Routine Management System",
  "author": {
    "name": "mih-zim",
    "email": "mih-zim@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.student.routine",
    "productName": "Student Routine Management System",
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "script.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "maintainer": "mih-zim <mih-zim@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
